{
    "name": "inline0/php-js",
    "description": "Pure PHP JavaScript engine. Lexes, parses, and executes ECMAScript without Node.js, FFI, or extensions.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "squizlabs/php_codesniffer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "PhpJs\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpJs\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php -d memory_limit=512M ./vendor/bin/phpunit",
        "test:unit": "@php -d memory_limit=512M ./vendor/bin/phpunit --testsuite=unit",
        "cs": "@php -d memory_limit=512M ./vendor/bin/phpcs",
        "cs:fix": "@php -d memory_limit=512M ./vendor/bin/phpcbf",
        "analyse": "@php -d memory_limit=4G ./vendor/bin/phpstan analyse"
    },
    "config": {
        "sort-packages": true
    }
}
