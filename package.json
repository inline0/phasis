{
  "name": "@phasis/tooling",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=26.12.0",
    "pnpm": ">=12.14.0"
  },
  "scripts": {
    "setup": "pnpm install --frozen-lockfile",
    "typecheck": "tsc --noEmit -p tsconfig.scripts.json",
    "test:scripts": "node --test \"scripts/**/*.test.ts\"",
    "check:docs": "node scripts/check-docs-content.ts --root docs --expected-docs 29 --expected-nav 4",
    "verify": "node scripts/verify-all.ts",
    "test:regression": "node scripts/test-regression.ts",
    "test:scenario": "node scripts/test-scenario.ts",
    "oracle": "node scripts/oracle.ts",
    "actual": "node scripts/actual.ts",
    "compare": "node scripts/compare.ts",
    "test:hydrate": "node tests/Jsx/oracle/hydrate.ts",
    "test:consumer": "node tests/Jsx/oracle/hydration-contract.ts",
    "oracle:jsx": "node tests/Jsx/oracle/jsx-oracle.ts",
    "oracle:typescript": "node tests/TypeScript/oracle.ts",
    "oracle:formatter": "node tests/Jsx/oracle/formatter-oracle.ts",
    "build:primitives": "node scripts/node-primitives/build.ts",
    "build:portable": "node scripts/node-portable/build.ts",
    "build:http-parser": "node scripts/node-http/build.ts",
    "build:react": "node tests/Jsx/oracle/build-vendor.ts",
    "build:react-scripts": "node tests/Jsx/oracle/build-scripts.ts",
    "build:calendar": "node scripts/gen-lunisolar-modern.ts",
    "oracle:primitives": "node scripts/node-primitives/generate-oracles.ts"
  },
  "devDependencies": {
    "effect": "catalog:",
    "@effect/platform-node": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "tar": "catalog:",
    "esbuild": "catalog:",
    "prettier": "catalog:"
  }
}
