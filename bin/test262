#!/usr/bin/env php
<?php

declare(strict_types=1);

ini_set('memory_limit', '1G');

require __DIR__ . '/../vendor/autoload.php';

use PhpJs\Tests\Oracle\Test262Runner;

$suiteDir = __DIR__ . '/../test262';
$supportConfig = require __DIR__ . '/../config/support.php';

if (!is_dir($suiteDir . '/test')) {
    fwrite(STDERR, "test262 suite not found. Run: git submodule update --init\n");
    exit(1);
}

$runner = new Test262Runner($suiteDir);

$runner->setSkipFeatures($supportConfig['test262_skipped_features']);

// Parse CLI args
$category = null;
$report = false;
$jobs = 1;
$showFailures = false;
$limit = 0;

$args = array_slice($argv, 1);
for ($i = 0; $i < count($args); $i++) {
    switch ($args[$i]) {
        case '--category':
            $category = $args[++$i] ?? null;
            break;
        case '--report':
            $report = true;
            break;
        case '--jobs':
            $jobs = (int) ($args[++$i] ?? 1);
            break;
        case '--failures':
            $showFailures = true;
            break;
        case '--limit':
            $limit = (int) ($args[++$i] ?? 0);
            break;
        default:
            if (!str_starts_with($args[$i], '--')) {
                $category = $args[$i];
            }
    }
}

$testDir = $suiteDir . '/test';
if ($category !== null) {
    $testDir .= '/' . $category;
    if (!is_dir($testDir)) {
        fwrite(STDERR, "Category not found: {$category}\n");
        exit(1);
    }
}

$count = 0;
$result = new \PhpJs\Tests\Oracle\SuiteResult();

echo "Running test262" . ($category ? " ({$category})" : '') . "...\n";

foreach ($runner->runDirectory($testDir) as $testResult) {
    $result->add($testResult);
    $count++;

    if ($testResult->status === \PhpJs\Tests\Oracle\TestStatus::Fail) {
        if ($showFailures) {
            $relative = str_replace($suiteDir . '/', '', $testResult->testPath);
            echo "FAIL: {$relative}\n";
            if ($testResult->message) {
                echo "      {$testResult->message}\n";
            }
        }
    }

    // Progress indicator every 100 tests
    if ($count % 100 === 0) {
        $rate = $result->passRate();
        fprintf(STDERR, "\r  %d tests (%d pass, %d fail, %d skip) %.1f%%", $count, $result->pass, $result->fail, $result->skip, $rate);
    }

    if ($limit > 0 && $count >= $limit) {
        break;
    }
}

fprintf(STDERR, "\r" . str_repeat(' ', 80) . "\r");

if ($report) {
    echo $result->report() . "\n";
} else {
    $attempted = $result->pass + $result->fail;
    echo sprintf(
        "\nResults: %d pass, %d fail, %d skip (%.1f%% of %d attempted)\n",
        $result->pass,
        $result->fail,
        $result->skip,
        $result->passRate(),
        $attempted,
    );
}
