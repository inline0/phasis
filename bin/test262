#!/usr/bin/env php
<?php

declare(strict_types=1);

ini_set('memory_limit', '1G');
// Safety net: no single test262 invocation should run longer than 30 min.
set_time_limit(1800);
// Bound PCRE backtracking so pathological test262 regex patterns fail fast
// instead of hanging the worker. set_time_limit() does not interrupt
// preg_match native calls, so without this a single hanging test can freeze
// a whole chunk and eat the shard budget. 200k is low enough to catch
// catastrophic backtracking within a second while still handling any
// reasonable non-pathological pattern (empirically, tests that legitimately
// need more than 200k backtracks are the ones that blow past the whole
// shard timeout anyway).
ini_set('pcre.backtrack_limit', '200000');
ini_set('pcre.recursion_limit', '100000');

require __DIR__ . '/../vendor/autoload.php';

use Phasis\Tests\Oracle\Test262Runner;

$suiteDir = __DIR__ . '/../test262';
$supportConfig = require __DIR__ . '/../config/support.php';

if (!is_dir($suiteDir . '/test')) {
    fwrite(STDERR, "test262 suite not found. Run: git submodule update --init\n");
    exit(1);
}

$runner = new Test262Runner($suiteDir);

$runner->setSkipFeatures($supportConfig['test262_skipped_features']);
$runner->setIsolatedTests((array) ($supportConfig['test262_isolated_tests'] ?? []));

// Parse CLI args
$category = null;
$report = false;
$jobs = 1;
$showFailures = false;
$limit = 0;
$filesFrom = null;
$json = false;
$progress = true;

$args = array_slice($argv, 1);
for ($i = 0; $i < count($args); $i++) {
    switch ($args[$i]) {
        case '--category':
            $category = $args[++$i] ?? null;
            break;
        case '--report':
            $report = true;
            break;
        case '--jobs':
            $jobs = (int) ($args[++$i] ?? 1);
            break;
        case '--failures':
            $showFailures = true;
            break;
        case '--limit':
            $limit = (int) ($args[++$i] ?? 0);
            break;
        case '--files-from':
            $filesFrom = $args[++$i] ?? null;
            break;
        case '--json':
            $json = true;
            $progress = false;
            break;
        case '--no-progress':
            $progress = false;
            break;
        default:
            if (!str_starts_with($args[$i], '--')) {
                $category = $args[$i];
            }
    }
}

$testDir = $suiteDir . '/test';
if ($filesFrom !== null) {
    if (!is_file($filesFrom)) {
        fwrite(STDERR, "File list not found: {$filesFrom}\n");
        exit(1);
    }
} elseif ($category !== null) {
    $testDir .= '/' . $category;
    if (!is_dir($testDir)) {
        fwrite(STDERR, "Category not found: {$category}\n");
        exit(1);
    }
}

$count = 0;
$result = new \Phasis\Tests\Oracle\SuiteResult();

if (!$json) {
    echo "Running test262";
    if ($filesFrom !== null) {
        echo " (file list)";
    } elseif ($category !== null) {
        echo " ({$category})";
    }
    echo "...\n";
}

if ($filesFrom !== null) {
    $paths = file($filesFrom, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);
    if ($paths === false) {
        fwrite(STDERR, "Unable to read file list: {$filesFrom}\n");
        exit(1);
    }
    $testResults = (function () use ($runner, $paths): \Generator {
        foreach ($paths as $path) {
            yield $runner->run($path);
        }
    })();
} else {
    $testResults = $runner->runDirectory($testDir);
}

$failingTests = [];
foreach ($testResults as $testResult) {
    $result->add($testResult);
    $count++;

    if ($testResult->status === \Phasis\Tests\Oracle\TestStatus::Fail) {
        $relative = str_replace($suiteDir . '/', '', $testResult->testPath);
        $failingTests[] = ['path' => $relative, 'message' => $testResult->message ?? ''];
        if ($showFailures) {
            echo "FAIL: {$relative}\n";
            if ($testResult->message) {
                echo "      {$testResult->message}\n";
            }
        } elseif ($json) {
            // Always emit failing paths to stderr in JSON mode so CI shard
            // logs surface the actual failing paths. The compat-report aggregator
            // only reads JSON counts from stdout; this stderr line is for humans
            // inspecting the workflow logs to identify which tests need attention.
            fwrite(STDERR, "FAIL: {$relative}\n");
            if ($testResult->message) {
                fwrite(STDERR, "      " . substr($testResult->message, 0, 200) . "\n");
            }
        }
    }

    // Progress indicator every 100 tests
    if ($progress && $count % 100 === 0) {
        $rate = $result->passRate();
        fprintf(STDERR, "\r  %d tests (%d pass, %d fail, %d skip) %.1f%%", $count, $result->pass, $result->fail, $result->skip, $rate);
    }

    // Long compat runs execute many tests in one PHP process. Periodic GC and
    // cache trimming reduces memory growth without changing interpreter semantics.
    if ($count % 50 === 0) {
        gc_collect_cycles();
        if (function_exists('gc_mem_caches')) {
            gc_mem_caches();
        }
    }

    if ($limit > 0 && $count >= $limit) {
        break;
    }
}

if ($progress) {
    fprintf(STDERR, "\r" . str_repeat(' ', 80) . "\r");
}

if ($json) {
    echo json_encode([
        'pass' => $result->pass,
        'fail' => $result->fail,
        'skip' => $result->skip,
        'attempted' => $result->pass + $result->fail,
        'total' => $result->total(),
        'passRate' => round($result->passRate(), 1),
        'category' => $category,
        'filesFrom' => $filesFrom,
        'failures' => $failingTests,
    ], JSON_UNESCAPED_SLASHES) . "\n";
} elseif ($report) {
    echo $result->report() . "\n";
} else {
    $attempted = $result->pass + $result->fail;
    echo sprintf(
        "\nResults: %d pass, %d fail, %d skip (%.1f%% of %d attempted)\n",
        $result->pass,
        $result->fail,
        $result->skip,
        $result->passRate(),
        $attempted,
    );
}
