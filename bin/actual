#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(dirname "$SCRIPT_DIR")"
SCENARIOS_DIR="$ROOT_DIR/scenarios"

usage() {
    echo "Usage: actual <scenario-name>"
    echo "  Runs php-js on a scenario and captures output."
    exit 1
}

if [[ $# -lt 1 ]]; then
    usage
fi

SCENARIO="$1"

# Find scenario directory
SCENARIO_DIR=$(find "$SCENARIOS_DIR" -type d -name "$SCENARIO" 2>/dev/null | head -1)

if [[ -z "$SCENARIO_DIR" ]]; then
    echo "Error: Scenario '$SCENARIO' not found in $SCENARIOS_DIR" >&2
    exit 1
fi

SETUP_FILE="$SCENARIO_DIR/setup/test.js"
ACTUAL_DIR="$SCENARIO_DIR/actual"
ACTUAL_FILE="$ACTUAL_DIR/output.txt"

if [[ ! -f "$SETUP_FILE" ]]; then
    echo "Error: Setup file not found: $SETUP_FILE" >&2
    exit 1
fi

mkdir -p "$ACTUAL_DIR"

# Check mode
MODE="parse"
if [[ -f "$SCENARIO_DIR/scenario.json" ]]; then
    MODE=$(node -e "const s=require('$SCENARIO_DIR/scenario.json'); console.log(s.mode||'parse')" 2>/dev/null || echo "parse")
fi

if [[ "$MODE" == "exec" ]]; then
    php "$ROOT_DIR/bin/phasis" "$SETUP_FILE" > "$ACTUAL_FILE" 2>&1
else
    php "$ROOT_DIR/bin/phasis" --ast "$SETUP_FILE" > "$ACTUAL_FILE" 2>&1
fi

echo "Actual captured: $ACTUAL_FILE"
