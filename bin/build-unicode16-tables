#!/usr/bin/env php
<?php
// Parses test262's Unicode 16 property-escape fixtures and emits a
// static PHP data file with the canonical code-point ranges for each
// property. The fixtures are generated by Mathias Bynens' tool from
// the Unicode 16.0.0 data files and are the authoritative reference
// for what \p{...} should match in ECMAScript regex.
//
// Output: src/Regex/Unicode16Tables.php — a single class with a
// PROPERTIES constant of the form:
//   [
//     'Alphabetic' => [[0x41, 0x5A], [0x61, 0x7A], ...],
//     'Script=Cyrillic' => [[0x400, 0x484], ...],
//     'Script_Extensions=Latin' => [...],
//     'General_Category=Letter' => [...],
//     ...
//   ]
// Ranges are sorted ascending, non-overlapping, and folded from
// loneCodePoints + ranges in the fixture. Surrogate range D800-DFFF
// is excluded (these are not valid Unicode scalar values).

declare(strict_types=1);

$rootDir = dirname(__DIR__);
$fixturesDir = $rootDir . '/test262/test/built-ins/RegExp/property-escapes/generated';

if (!is_dir($fixturesDir)) {
    fwrite(STDERR, "Fixtures dir not found: $fixturesDir\n");
    exit(1);
}

$properties = [];
$processed = 0;
$skipped = 0;

foreach (glob($fixturesDir . '/*.js') as $path) {
    $source = file_get_contents($path);
    if ($source === false) {
        $skipped++;
        continue;
    }
    $key = extractPropertyKey($source);
    if ($key === null) {
        $skipped++;
        continue;
    }
    $ranges = extractMatchRanges($source);
    if ($ranges === null) {
        $skipped++;
        continue;
    }
    // Index the canonical key from the description AND every alias
    // form exercised by testPropertyEscapes inside this fixture. The
    // fixture tests "Script=Cyrillic", "Script=Cyrl", "sc=Cyrillic",
    // "sc=Cyrl" — all four should look up the same matchSymbols. On
    // host ICU that lags Unicode 16, IntlChar can't resolve the
    // alias forms for newly-added scripts (e.g. Onao -> Ol_Onal), so
    // we cannot rely on host-side normalization at lookup time;
    // every form must already be present in the bundled table.
    $aliases = extractAllPropertyForms($source);
    $aliases[] = $key;
    foreach (array_unique($aliases) as $form) {
        $properties[$form] = $ranges;
    }
    $processed++;
}

// Sort the property keys so the emitted file is stable across runs.
ksort($properties);

$outPath = $rootDir . '/src/Regex/Unicode16Tables.php';
writePhpFile($outPath, $properties);

fwrite(STDERR, "Processed $processed fixtures, skipped $skipped.\n");
fwrite(STDERR, "Wrote " . count($properties) . " property tables to $outPath\n");

/**
 * Extract the canonical property key from the fixture's description
 * comment. The fixture header reads e.g.
 *   description: >
 *     Unicode property escapes for `Script=Cyrillic`
 * for property=value form, or
 *     Unicode property escapes for `Alphabetic`
 * for a bare property. Returns the property key in canonical form
 * (with `=` separator) or null if the format does not match.
 */
function extractPropertyKey(string $source): ?string
{
    if (!preg_match('/Unicode property escapes for `([^`]+)`/', $source, $m)) {
        return null;
    }
    return $m[1];
}

/**
 * Extract every \p{...} form the fixture's testPropertyEscapes calls
 * exercise. Returns the form verbatim as it appears in the regex
 * source: e.g. ["Script=Cyrillic", "Script=Cyrl", "sc=Cyrillic",
 * "sc=Cyrl"] or ["Alphabetic"] for a bare property.
 *
 * @return list<string>
 */
function extractAllPropertyForms(string $source): array
{
    // testPropertyEscapes(/^\p{<...>}+$/u, matchSymbols, ...) — the
    // first arg is always a regex literal of that shape.
    $forms = [];
    if (preg_match_all('#testPropertyEscapes\(\s*/\^\\\\p\{([^}]+)\}\+\$/u#', $source, $hits)) {
        foreach ($hits[1] as $form) {
            $forms[] = $form;
        }
    }
    return $forms;
}

/**
 * Extract the matchSymbols block and fold it into a sorted array of
 * inclusive [start, end] ranges. Surrogate code points D800-DFFF are
 * excluded — they are not Unicode scalar values and the regex matcher
 * never sees them as input.
 *
 * @return list<array{int, int}>|null
 */
function extractMatchRanges(string $source): ?array
{
    if (!preg_match(
        '/const\s+matchSymbols\s*=\s*buildString\(\{([\s\S]*?)\}\);/',
        $source,
        $m,
    )) {
        return null;
    }
    $body = $m[1];

    $ranges = [];

    // loneCodePoints: [0xNNNN, 0xNNNN, ...]
    if (preg_match('/loneCodePoints\s*:\s*\[([^\]]*)\]/', $body, $lm)) {
        if (preg_match_all('/0x([0-9A-Fa-f]+)/', $lm[1], $hits)) {
            foreach ($hits[1] as $hex) {
                $cp = hexdec($hex);
                $ranges[] = [$cp, $cp];
            }
        }
    }

    // ranges: [[0xAAAA, 0xBBBB], [0xCCCC, 0xDDDD], ...]
    // Find the start of the ranges block, then grab all inner pairs
    // from there to the end of the body. Tracking nested brackets
    // with a regex is fragile; the inner-pair regex is unambiguous
    // (each inner pair is "[0xN, 0xN]") so any pair appearing after
    // "ranges:" is a range entry.
    if (preg_match('/ranges\s*:\s*\[/', $body, $rm, PREG_OFFSET_CAPTURE)) {
        $tail = substr($body, $rm[0][1] + strlen($rm[0][0]));
        if (preg_match_all('/\[\s*0x([0-9A-Fa-f]+)\s*,\s*0x([0-9A-Fa-f]+)\s*\]/', $tail, $hits, PREG_SET_ORDER)) {
            foreach ($hits as $h) {
                $ranges[] = [hexdec($h[1]), hexdec($h[2])];
            }
        }
    }

    if ($ranges === []) {
        // Empty matchSymbols is valid (e.g. some negative-of fixtures)
        // but we still want a row so the matcher can answer "no" without
        // falling back to IntlChar. Encode as empty list.
        return [];
    }

    return foldRanges($ranges);
}

/**
 * Sort the ranges by start, merge adjacent/overlapping, and remove the
 * surrogate range D800-DFFF entirely.
 *
 * @param list<array{int, int}> $ranges
 * @return list<array{int, int}>
 */
function foldRanges(array $ranges): array
{
    usort($ranges, static fn($a, $b) => $a[0] <=> $b[0]);
    $merged = [];
    foreach ($ranges as [$start, $end]) {
        if ($merged !== [] && $start <= end($merged)[1] + 1) {
            $merged[count($merged) - 1][1] = max($merged[count($merged) - 1][1], $end);
        } else {
            $merged[] = [$start, $end];
        }
    }

    // Strip surrogates: [D800, DFFF] is reserved for UTF-16 surrogate
    // halves and never appears in a valid Unicode string. The regex
    // matcher receives codepoints from a UTF-8 decoder that already
    // rejects lone surrogates.
    $stripped = [];
    foreach ($merged as [$start, $end]) {
        if ($end < 0xD800 || $start > 0xDFFF) {
            $stripped[] = [$start, $end];
            continue;
        }
        if ($start < 0xD800) {
            $stripped[] = [$start, 0xD7FF];
        }
        if ($end > 0xDFFF) {
            $stripped[] = [0xE000, $end];
        }
    }

    return $stripped;
}

/**
 * Emit a PHP file holding the property → ranges table. The file is
 * regenerated by bin/build-unicode16-tables; do not edit by hand.
 *
 * @param array<string, list<array{int, int}>> $properties
 */
function writePhpFile(string $path, array $properties): void
{
    $entries = '';
    foreach ($properties as $key => $ranges) {
        $rangeStrs = [];
        foreach ($ranges as [$start, $end]) {
            $rangeStrs[] = sprintf('[0x%X,0x%X]', $start, $end);
        }
        $entries .= sprintf(
            "        %s => [%s],\n",
            var_export($key, true),
            implode(',', $rangeStrs),
        );
    }

    $header = <<<'PHP'
<?php

declare(strict_types=1);

namespace PhpJs\Regex;

/**
 * Auto-generated Unicode 16.0.0 code-point ranges for ECMAScript
 * regex property escapes, extracted from the test262 property-escape
 * fixtures (built by Mathias Bynens from the Unicode 16 data files).
 *
 * Regenerate with: bin/build-unicode16-tables
 *
 * The table makes the regex matcher independent of the host ICU
 * Unicode version. Ubuntu CI ships ICU 74 (Unicode 14) which
 * disagrees with the test262 fixtures' Unicode 16 reference for a
 * couple hundred properties; bundling the canonical data here is
 * cheaper and more portable than waiting for every host's ICU to
 * catch up.
 *
 * Each key is either a bare binary-property name ("Alphabetic") or
 * a property=value pair ("Script=Cyrillic", "Script_Extensions=Latin",
 * "General_Category=Letter"). The value is a sorted list of inclusive
 * [start, end] code-point pairs; surrogate code points D800-DFFF are
 * already excluded.
 *
 * Lookup is O(log n) via binary search; see Matcher::lookupBundledProperty.
 */
final class Unicode16Tables
{
    /** @var array<string, list<array{int, int}>> */
    public const PROPERTIES = [

PHP;
    $footer = "    ];\n}\n";

    file_put_contents($path, $header . $entries . $footer);
}
