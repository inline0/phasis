#!/usr/bin/env php
<?php

declare(strict_types=1);

use Phasis\Tests\Remix\CompatibilityRunner;

require dirname(__DIR__) . '/vendor/autoload.php';

$runner = new CompatibilityRunner();
if (function_exists('pcntl_async_signals')) {
    pcntl_async_signals(true);
    pcntl_signal(SIGTERM, static function (): never {
        exit(143);
    });
    pcntl_signal(SIGINT, static function (): never {
        exit(130);
    });
}
try {
    $report = $runner->run();
    $checkBaseline = in_array('--check-baseline', $argv, true);
    $regressions = $checkBaseline ? CompatibilityRunner::regressions($report) : [];
    $report['regressions'] = $regressions;
    if (in_array('--json', $argv, true)) {
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_INVALID_UTF8_SUBSTITUTE | JSON_THROW_ON_ERROR), "\n";
    } else {
        printf("Remix %s: %d pass, %d fail, %d blocked\n", $report['package']['version'], ...array_values($report['counts']));
        foreach ($report['results'] as $result) {
            if ($result['status'] !== 'pass') {
                $error = $result['actual'] ?? $result['oracle'];
                printf("%s %s: %s\n", strtoupper($result['status']), $result['id'], $error['message'] ?? 'Output differs from Node');
            }
        }
        echo $report['coverageNote'], "\n";
        if ($checkBaseline) {
            printf("Baseline regressions: %d. Known failures remain failures in the report.\n", count($regressions));
        }
    }
    exit($checkBaseline ? ($regressions === [] ? 0 : 1) : ($report['allProbesPassed'] ? 0 : 1));
} catch (Throwable $error) {
    fwrite(STDERR, $error->getMessage() . "\n");
    exit(2);
}
