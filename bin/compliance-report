#!/usr/bin/env php
<?php

declare(strict_types=1);

ini_set('memory_limit', '1G');

$limit = (int) ($argv[1] ?? 50);
$jobs = (int) ($argv[2] ?? 4);
$supportConfig = require __DIR__ . '/../config/support.php';

$categories = $supportConfig['test262_categories'];

$phpBin = PHP_BINARY;
$test262Bin = __DIR__ . '/test262';
$rootDir = dirname(__DIR__);

// Run categories in parallel batches
$results = [];
$batches = array_chunk($categories, $jobs);

foreach ($batches as $batch) {
    $procs = [];
    foreach ($batch as $cat) {
        $cmd = $phpBin . ' ' . escapeshellarg($test262Bin)
            . ' --category ' . escapeshellarg($cat)
            . ' --limit ' . $limit . ' 2>/dev/null';
        $spec = [0 => ['pipe', 'r'], 1 => ['pipe', 'w'], 2 => ['file', '/dev/null', 'w']];
        $proc = proc_open($cmd, $spec, $pipes, $rootDir);
        if ($proc) {
            fclose($pipes[0]);
            $procs[] = ['proc' => $proc, 'pipe' => $pipes[1], 'cat' => $cat];
        }
    }

    // Wait for all in batch
    foreach ($procs as $p) {
        $output = stream_get_contents($p['pipe']);
        fclose($p['pipe']);
        proc_close($p['proc']);

        if (preg_match('/(\d+) pass, (\d+) fail, (\d+) skip \(([\d.]+)% of (\d+) attempted\)/', $output, $m)) {
            $r = [
                'cat' => $p['cat'], 'pass' => (int) $m[1], 'fail' => (int) $m[2],
                'skip' => (int) $m[3], 'rate' => (float) $m[4], 'attempted' => (int) $m[5],
            ];
            $results[] = $r;
            fprintf(STDERR, "  %-42s %4d / %4d (%5.1f%%)\n", $r['cat'], $r['pass'], $r['attempted'], $r['rate']);
        }
    }
}

$totalPass = array_sum(array_column($results, 'pass'));
$totalFail = array_sum(array_column($results, 'fail'));
$totalSkip = array_sum(array_column($results, 'skip'));
$totalAttempted = $totalPass + $totalFail;
$totalRate = $totalAttempted > 0 ? round($totalPass / $totalAttempted * 100, 1) : 0;

echo "\nphp-js test262 Compliance Report\n";
echo "================================\n";
echo sprintf("OVERALL: %d / %d (%.1f%%)\n", $totalPass, $totalAttempted, $totalRate);
echo sprintf("Skipped: %d | %s | %d tests/cat, %d workers\n\n", $totalSkip, date('Y-m-d H:i'), $limit, $jobs);

usort($results, fn($a, $b) => $b['rate'] <=> $a['rate']);
foreach ($results as $r) {
    if ($r['attempted'] > 0) {
        echo sprintf("  %-42s %4d / %4d (%5.1f%%)\n", $r['cat'], $r['pass'], $r['attempted'], $r['rate']);
    }
}

file_put_contents($rootDir . '/compliance.json', json_encode([
    'date' => date('c'), 'overall' => compact('totalPass', 'totalFail', 'totalSkip', 'totalRate'),
    'categories' => $results,
], JSON_PRETTY_PRINT) . "\n");
echo "\nSaved to compliance.json\n";
