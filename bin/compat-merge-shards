#!/usr/bin/env php
<?php

declare(strict_types=1);

// Merges per-shard compat state dirs produced by the compat-matrix CI
// workflow into a unified .compat-state directory and regenerates compat.json
// + COMPAT.md.

ini_set('memory_limit', '2G');

$rootDir = dirname(__DIR__);
$shardsDir = $argv[1] ?? '.compat-shards';
if (!str_starts_with($shardsDir, '/')) {
    $shardsDir = $rootDir . '/' . $shardsDir;
}

if (!is_dir($shardsDir)) {
    fwrite(STDERR, "Shards directory not found: {$shardsDir}\n");
    exit(1);
}

define('COMPAT_REPORT_LIB_ONLY', true);
require $rootDir . '/bin/compat-report';

$supportConfig = require $rootDir . '/config/support.php';
$suiteDir = $rootDir . '/test262/test';

$discovery = discoverCompatGroups($suiteDir, null, []);
if ($discovery['groups'] === []) {
    fwrite(STDERR, "No compat groups found\n");
    exit(1);
}

$stateDir = $rootDir . '/.compat-state';
if (is_dir($stateDir)) {
    removeDirectory($stateDir);
}
ensureDirectory($stateDir);
ensureDirectory($stateDir . '/results');
ensureDirectory($stateDir . '/logs');
ensureDirectory($stateDir . '/manifests');

// Build discovery metadata, then merge verified shard manifests.
$options = [
    'jobs' => 4,
    'match' => null,
    'exclude' => [],
    // Only missing files use this chunk size; existing shard sizes may differ.
    'chunkSize' => 25,
    'timeoutSec' => 300,
    'stateDir' => '.compat-state',
    'reset' => false,
];
$runIdentity = buildCompatRunIdentity($rootDir);
$fingerprint = buildCompatFingerprint($rootDir, $options, $supportConfig, $discovery, $runIdentity);
$state = loadOrCreateCompatState(
    $stateDir,
    '.compat-state',
    $rootDir,
    $fingerprint,
    $discovery,
    $options,
    $supportConfig,
    $runIdentity,
);

$shardEntries = glob($shardsDir . '/compat-shard-*', GLOB_ONLYDIR) ?: [];
fwrite(STDERR, "Merging " . count($shardEntries) . " shards...\n");

$mergedChunks = 0;
$state['chunks'] = [];
foreach ($shardEntries as $shardPath) {
    $shardState = $shardPath . '/state.json';
    if (!is_file($shardState)) {
        fwrite(STDERR, "  skipping {$shardPath} (no state.json)\n");
        continue;
    }
    $data = json_decode((string) file_get_contents($shardState), true);
    if (!is_array($data)) {
        throw new RuntimeException('Invalid shard state: ' . $shardState);
    }
    $mergedChunks += mergeCompatShardChunks($state, $data, $rootDir);
}
fwrite(STDERR, "Merged {$mergedChunks} chunk records.\n");

$coverage = reconcileCompatCoverage($state, $discovery['groups']);
fwrite(STDERR, "Verified {$coverage['covered']} manifest entries; {$coverage['missing']} files missing.\n");

$state['updatedAt'] = date('c');

writeCompatState($stateDir, $state);
writeCompatArtifacts($rootDir, $state, $supportConfig, $state['completed']);

fwrite(STDERR, "Done. compat.json + COMPAT.md written.\n");
if (!$state['completed']) {
    fwrite(STDERR, "Compatibility matrix is incomplete; pending coverage remains.\n");
    exit(1);
}
