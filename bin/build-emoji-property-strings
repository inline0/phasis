#!/usr/bin/env php
<?php

declare(strict_types=1);

require dirname(__DIR__) . '/scripts/unicode-data.php';

if ($argc > 2) {
    fwrite(STDERR, "Usage: bin/build-emoji-property-strings [unicode-data-directory]\n");
    exit(1);
}
$directory = $argv[1] ?? null;
$properties = [];
foreach (['emoji-sequences.txt', 'emoji-zwj-sequences.txt'] as $source) {
    foreach (unicodeDataRecords(readUnicodeData($source, $directory)) as $fields) {
        $property = $fields[1];
        if (str_contains($fields[0], '..')) {
            [$first, $last] = array_map('hexdec', explode('..', $fields[0]));
            for ($codepoint = (int) $first; $codepoint <= $last; $codepoint++) {
                $properties[$property][] = [$codepoint];
            }
        } else {
            $properties[$property][] = array_map(
                static fn (string $cp): int => (int) hexdec($cp),
                explode(' ', $fields[0]),
            );
        }
    }
}
$properties['RGI_Emoji'] = array_merge(...array_values($properties));
ksort($properties);

$out = "<?php\n\n"
    . "// Generated Unicode " . UNICODE_DATA_VERSION . " properties of strings for the RegExp /v flag.\n"
    . "// Sources: https://www.unicode.org/Public/" . UNICODE_DATA_VERSION . "/emoji/\n"
    . "// Regenerate with: bin/build-emoji-property-strings\n"
    . "// Unicode data license: UNICODE-LICENSE.txt in the package root.\n"
    . "// JS \\u{HEX} escapes are translated to PCRE \\x{HEX} by the runtime.\n"
    . "return [\n";
foreach ($properties as $property => $sequences) {
    // RegExp string-set alternatives must prefer the longest matching sequence.
    usort($sequences, static fn (array $a, array $b): int => (count($b) <=> count($a)) ?: ($a <=> $b));
    $out .= '    ' . var_export($property, true) . " => [\n";
    foreach ($sequences as $codepoints) {
        $sequence = implode('', array_map(static fn (int $cp): string => sprintf('\\u{%X}', $cp), $codepoints));
        $out .= '        ' . var_export($sequence, true) . ",\n";
    }
    $out .= "    ],\n";
}
$out .= "];\n";
$path = dirname(__DIR__) . '/config/regex_property_strings.php';
if (file_put_contents($path, $out) === false) {
    throw new RuntimeException("Could not write {$path}");
}
fwrite(STDERR, "Generated " . count($properties) . " Unicode " . UNICODE_DATA_VERSION . " emoji string properties.\n");
