#!/usr/bin/env php
<?php

declare(strict_types=1);

(static function (): void {
    foreach ([__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'] as $autoload) {
        if (is_file($autoload)) {
            require_once $autoload;

            return;
        }
    }

    fwrite(STDERR, "Could not locate the Composer autoloader. Run `composer install`.
");
    exit(1);
})();

use Phasis\Ast\Serializer;
use Phasis\Engine;
use Phasis\Node\NodeCommand;
use Phasis\Parser\Parser;

$args = array_slice($argv, 1);
$opts = getopt('e:', ['ast', 'repl', 'render:', 'props:', 'node'], $restIndex);
$nodeMode = isset($opts['node']);

if (isset($opts['render'])) {
    $file = (string) $opts['render'];
    if (!file_exists($file)) {
        fwrite(STDERR, "Usage: phasis --render <component.jsx> [--props '<json>']\n");
        exit(1);
    }
    $props = isset($opts['props']) ? json_decode((string) $opts['props'], true) : [];
    if (!is_array($props)) {
        fwrite(STDERR, "--props must be a JSON object\n");
        exit(1);
    }
    $engine = new Engine();
    try {
        echo $engine->render($file, $props) . "\n";
    } catch (\Throwable $e) {
        fwrite(STDERR, $e->getMessage() . "\n");
        exit(1);
    }
    exit(0);
}

if (isset($opts['e'])) {
    $source = $opts['e'];

    if (isset($opts['ast'])) {
        outputAst($source);
    } elseif ($nodeMode) {
        exit(NodeCommand::runSource($source, array_slice($argv, $restIndex)));
    } else {
        executeSource($source);
    }
    exit(0);
}

if (in_array('--ast', $args, true)) {
    $fileIdx = array_search('--ast', $args);
    $file = $args[$fileIdx + 1] ?? null;
    if ($file === null || !file_exists($file)) {
        fwrite(STDERR, "Usage: phasis --ast <file.js>\n");
        exit(1);
    }
    outputAst(file_get_contents($file), $file);
    exit(0);
}

// Default: execute a file
$file = $argv[$restIndex] ?? null;
if ($file === null || !file_exists($file)) {
    fwrite(STDERR, "Usage: phasis [--node] <file.js|file.mjs|file.jsx> [args] | phasis [--node] -e '<expr>' | phasis --ast <file> | phasis --render <component.jsx> [--props '<json>']\n");
    exit(1);
}

if ($nodeMode) {
    exit(NodeCommand::runFile($file, array_slice($argv, $restIndex + 1)));
}

$jsx = new \Phasis\Parser\Jsx\JsxOptions();
if (str_ends_with(strtolower($file), '.mjs') || $jsx->appliesTo($file)) {
    // Modules (.mjs, .jsx) go through the module loader so imports resolve.
    $engine = new Engine();
    try {
        $engine->execFile($file);
        $output = $engine->getConsoleOutput();
        if ($output !== '') {
            echo $output . "\n";
        }
    } catch (\Throwable $e) {
        fwrite(STDERR, $e->getMessage() . "\n");
        exit(1);
    }
    exit(0);
}

executeSource(file_get_contents($file));

function executeSource(string $source): void
{
    $engine = new Engine();
    try {
        $engine->eval($source);
        $output = $engine->getConsoleOutput();
        if ($output !== '') {
            echo $output . "\n";
        }
    } catch (\Throwable $e) {
        fwrite(STDERR, $e->getMessage() . "\n");
        exit(1);
    }
}

function outputAst(string $source, ?string $file = null): void
{
    $jsx = new \Phasis\Parser\Jsx\JsxOptions(mode: \Phasis\Parser\Jsx\JsxMode::Preserve);
    $isJsx = $file !== null && $jsx->appliesTo($file);
    $ast = Parser::parseSource($source, $isJsx ? 'module' : 'script', $isJsx ? $jsx : null);
    echo jsonIndent2(Serializer::toArray($ast)) . "\n";
}

function jsonIndent2(mixed $data): string
{
    $json = json_encode($data, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);
    return preg_replace_callback('/^( +)/m', function ($matches) {
        return str_repeat(' ', (int) (strlen($matches[1]) / 2));
    }, $json);
}
