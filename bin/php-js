#!/usr/bin/env php
<?php

declare(strict_types=1);

require __DIR__ . '/../vendor/autoload.php';

use PhpJs\Engine;
use PhpJs\Parser\Parser;

$args = array_slice($argv, 1);
$opts = getopt('e:', ['ast', 'repl']);

if (isset($opts['e'])) {
    $source = $opts['e'];

    if (isset($opts['ast'])) {
        outputAst($source);
    } else {
        executeSource($source);
    }
    exit(0);
}

if (in_array('--ast', $args, true)) {
    $fileIdx = array_search('--ast', $args);
    $file = $args[$fileIdx + 1] ?? null;
    if ($file === null || !file_exists($file)) {
        fwrite(STDERR, "Usage: php-js --ast <file.js>\n");
        exit(1);
    }
    outputAst(file_get_contents($file));
    exit(0);
}

// Default: execute a file
$file = $args[0] ?? null;
if ($file === null || !file_exists($file)) {
    fwrite(STDERR, "Usage: php-js <file.js> | php-js -e '<expr>' | php-js --ast <file.js>\n");
    exit(1);
}

executeSource(file_get_contents($file));

function executeSource(string $source): void
{
    $engine = new Engine();
    try {
        $engine->eval($source);
        $output = $engine->getConsoleOutput();
        if ($output !== '') {
            echo $output . "\n";
        }
    } catch (\Throwable $e) {
        fwrite(STDERR, $e->getMessage() . "\n");
        exit(1);
    }
}

function outputAst(string $source): void
{
    $parser = new Parser($source);
    $program = $parser->parse();
    echo jsonIndent2(astToArray($program)) . "\n";
}

function astToArray(object $node): array
{
    $result = ['type' => $node->type()];
    $ref = new ReflectionClass($node);

    foreach ($ref->getProperties(ReflectionProperty::IS_PUBLIC) as $prop) {
        $name = $prop->getName();
        // Skip internal implementation fields not present in standard AST output.
        if (
            $name === 'location'
            || $name === 'verbatim'
            || $name === 'cached'
            || $name === 'bodyHasClosure'
            || $name === 'hoistsLexicalCache'
            || $name === 'hoistsVarOrFuncCache'
            || $name === 'resolvedDepth'
        ) {
            continue;
        }
        $value = $prop->getValue($node);
        $result[$name] = convertValue($value);
    }

    ksort($result);
    return $result;
}

function convertValue(mixed $value): mixed
{
    if ($value === null) {
        return null;
    }
    if (is_scalar($value)) {
        return $value;
    }
    if (is_array($value)) {
        return array_map(fn($v) => convertValue($v), $value);
    }
    if (is_object($value) && method_exists($value, 'type')) {
        return astToArray($value);
    }
    return (string) $value;
}

function jsonIndent2(mixed $data): string
{
    $json = json_encode($data, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);
    return preg_replace_callback('/^( +)/m', function ($matches) {
        return str_repeat(' ', (int) (strlen($matches[1]) / 2));
    }, $json);
}
