#!/usr/bin/env php
<?php

declare(strict_types=1);

ini_set('memory_limit', '1G');

$limit = (int) ($argv[1] ?? 50);
$jobs = max(1, (int) ($argv[2] ?? 4));

$rootDir = dirname(__DIR__);
$supportConfig = require $rootDir . '/config/support.php';

fwrite(STDERR, "Building support snapshot...\n");

$snapshot = [
    'generatedAt' => date('c'),
    'git' => detectGitMetadata($rootDir),
    'environment' => [
        'phpVersion' => PHP_VERSION,
        'nodeVersion' => detectCommandVersion('node --version', $rootDir),
    ],
    'sourceOfTruth' => [
        'scenarioRegression' => './bin/test-regression',
        'test262' => './bin/test262',
        'oracleSnapshots' => 'scenarios/*/oracle/output.txt',
    ],
];

$snapshot['scenarios'] = buildScenarioSnapshot($rootDir);
$snapshot['test262'] = buildTest262Snapshot(
    $rootDir,
    $supportConfig['test262_categories'],
    $supportConfig['test262_skipped_features'],
    $limit,
    $jobs,
);
$snapshot['summary'] = [
    'scenarios' => $snapshot['scenarios']['totals'],
    'test262' => $snapshot['test262']['totals'],
];

$jsonPath = $rootDir . '/support.json';
$markdownPath = $rootDir . '/SUPPORT.md';

file_put_contents(
    $jsonPath,
    json_encode($snapshot, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n",
);
file_put_contents($markdownPath, renderSupportMarkdown($snapshot));

echo "Support snapshot written:\n";
echo "  - support.json\n";
echo "  - SUPPORT.md\n";
echo sprintf(
    "Summary: scenarios %d/%d pass, test262 sample %d/%d pass (limit %d/category)\n",
    $snapshot['scenarios']['totals']['pass'],
    $snapshot['scenarios']['totals']['total'],
    $snapshot['test262']['totals']['pass'],
    $snapshot['test262']['totals']['attempted'],
    $limit,
);

/**
 * @return array{branch: ?string, commit: ?string, isDirty: bool}
 */
function detectGitMetadata(string $rootDir): array
{
    $branch = trim(runShellCommand('git rev-parse --abbrev-ref HEAD', $rootDir)['output']);
    $commit = trim(runShellCommand('git rev-parse --short HEAD', $rootDir)['output']);
    $dirty = trim(runShellCommand('git status --short', $rootDir)['output']) !== '';

    return [
        'branch' => $branch !== '' ? $branch : null,
        'commit' => $commit !== '' ? $commit : null,
        'isDirty' => $dirty,
    ];
}

function detectCommandVersion(string $command, string $rootDir): ?string
{
    $result = runShellCommand($command, $rootDir);
    if ($result['exitCode'] !== 0) {
        return null;
    }

    $version = trim($result['output']);

    return $version !== '' ? $version : null;
}

/**
 * @return array{
 *   totals: array{pass: int, fail: int, skip: int, total: int, attempted: int, passRate: float},
 *   categories: list<array{name: string, status: string, pass: int, fail: int, skip: int, total: int, attempted: int, passRate: float}>,
 *   tests: list<array{name: string, category: string, mode: string, status: string, setupFile: string, oracleFile: ?string, message: string}>
 * }
 */
function buildScenarioSnapshot(string $rootDir): array
{
    fwrite(STDERR, "  - scenarios\n");

    $scenarioRoot = $rootDir . '/scenarios';
    $tests = [];

    $iterator = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator($scenarioRoot, RecursiveDirectoryIterator::SKIP_DOTS),
    );

    foreach ($iterator as $file) {
        if ($file->getFilename() !== 'test.js' || basename($file->getPath()) !== 'setup') {
            continue;
        }

        $setupFile = $file->getPathname();
        $scenarioDir = dirname(dirname($setupFile));
        $relativeScenario = relativePath($scenarioDir, $rootDir . '/');
        $scenarioName = relativePath($scenarioDir, $scenarioRoot . '/');
        $parts = explode('/', $scenarioName);
        $category = $parts[0];
        $mode = readScenarioMode($scenarioDir);
        $oracleFile = $scenarioDir . '/oracle/output.txt';

        $status = 'skip';
        $message = 'Missing oracle snapshot';

        if (is_file($oracleFile)) {
            $command = $mode === 'exec'
                ? PHP_BINARY . ' ' . escapeshellarg($rootDir . '/bin/php-js') . ' ' . escapeshellarg($setupFile)
                : PHP_BINARY . ' ' . escapeshellarg($rootDir . '/bin/php-js') . ' --ast ' . escapeshellarg($setupFile);

            $result = runShellCommand($command, $rootDir);
            $expected = file_get_contents($oracleFile);
            if ($expected === false) {
                $status = 'skip';
                $message = 'Unable to read oracle snapshot';
            } elseif ($result['output'] === $expected) {
                $status = 'pass';
                $message = '';
            } else {
                $status = 'fail';
                $message = $result['exitCode'] === 0
                    ? 'Output mismatch'
                    : 'Command exited with code ' . $result['exitCode'];
            }
        }

        $tests[] = [
            'name' => $scenarioName,
            'category' => $category,
            'mode' => $mode,
            'status' => $status,
            'setupFile' => $relativeScenario . '/setup/test.js',
            'oracleFile' => is_file($oracleFile) ? $relativeScenario . '/oracle/output.txt' : null,
            'message' => $message,
        ];
    }

    usort($tests, static fn(array $left, array $right): int => $left['name'] <=> $right['name']);

    $categoryMap = [];
    foreach ($tests as $test) {
        if (!isset($categoryMap[$test['category']])) {
            $categoryMap[$test['category']] = [
                'name' => $test['category'],
                'pass' => 0,
                'fail' => 0,
                'skip' => 0,
                'total' => 0,
                'attempted' => 0,
                'status' => 'empty',
                'passRate' => 0.0,
            ];
        }

        $categoryMap[$test['category']]['total']++;
        $categoryMap[$test['category']][$test['status']]++;
        if ($test['status'] !== 'skip') {
            $categoryMap[$test['category']]['attempted']++;
        }
    }

    foreach ($categoryMap as &$category) {
        $category['status'] = aggregateStatus($category['pass'], $category['fail'], $category['skip']);
        $category['passRate'] = rateFromCounts($category['pass'], $category['fail']);
    }
    unset($category);

    ksort($categoryMap);
    $categories = array_values($categoryMap);

    $totals = [
        'pass' => countByStatus($tests, 'pass'),
        'fail' => countByStatus($tests, 'fail'),
        'skip' => countByStatus($tests, 'skip'),
        'total' => count($tests),
        'attempted' => countByStatus($tests, 'pass') + countByStatus($tests, 'fail'),
        'passRate' => rateFromCounts(countByStatus($tests, 'pass'), countByStatus($tests, 'fail')),
    ];

    return [
        'totals' => $totals,
        'categories' => $categories,
        'tests' => $tests,
    ];
}

function readScenarioMode(string $scenarioDir): string
{
    $scenarioFile = $scenarioDir . '/scenario.json';
    if (!is_file($scenarioFile)) {
        return 'parse';
    }

    $decoded = json_decode((string) file_get_contents($scenarioFile), true);
    if (!is_array($decoded)) {
        return 'parse';
    }

    $mode = $decoded['mode'] ?? 'parse';

    return is_string($mode) && $mode !== '' ? $mode : 'parse';
}

/**
 * @param list<string> $categories
 * @param list<string> $skippedFeatures
 * @return array{
 *   sampleLimit: int,
 *   jobs: int,
 *   trackedCategories: int,
 *   skippedFeatures: list<string>,
 *   totals: array{pass: int, fail: int, skip: int, attempted: int, total: int, passRate: float},
 *   categories: list<array{name: string, status: string, pass: int, fail: int, skip: int, attempted: int, total: int, passRate: float}>
 * }
 */
function buildTest262Snapshot(
    string $rootDir,
    array $categories,
    array $skippedFeatures,
    int $limit,
    int $jobs,
): array {
    fwrite(STDERR, "  - test262 sample\n");

    $results = [];
    $batches = array_chunk($categories, $jobs);

    foreach ($batches as $batch) {
        $processes = [];

        foreach ($batch as $category) {
            $command = PHP_BINARY . ' ' . escapeshellarg($rootDir . '/bin/test262')
                . ' --category ' . escapeshellarg($category)
                . ' --limit ' . $limit;
            $spec = [
                0 => ['pipe', 'r'],
                1 => ['pipe', 'w'],
                2 => ['file', '/dev/null', 'w'],
            ];
            $process = proc_open($command, $spec, $pipes, $rootDir);
            if (!is_resource($process)) {
                $results[] = [
                    'name' => $category,
                    'pass' => 0,
                    'fail' => 0,
                    'skip' => 0,
                    'attempted' => 0,
                    'total' => 0,
                    'status' => 'empty',
                    'passRate' => 0.0,
                ];
                continue;
            }

            fclose($pipes[0]);
            $processes[] = [
                'process' => $process,
                'pipe' => $pipes[1],
                'name' => $category,
            ];
        }

        foreach ($processes as $entry) {
            $output = stream_get_contents($entry['pipe']);
            fclose($entry['pipe']);
            proc_close($entry['process']);

            if (preg_match('/Results:\s+(\d+) pass, (\d+) fail, (\d+) skip \(([\d.]+)% of (\d+) attempted\)/', $output, $matches) !== 1) {
                $results[] = [
                    'name' => $entry['name'],
                    'pass' => 0,
                    'fail' => 0,
                    'skip' => 0,
                    'attempted' => 0,
                    'total' => 0,
                    'status' => 'empty',
                    'passRate' => 0.0,
                ];
                continue;
            }

            $result = [
                'name' => $entry['name'],
                'pass' => (int) $matches[1],
                'fail' => (int) $matches[2],
                'skip' => (int) $matches[3],
                'attempted' => (int) $matches[5],
                'total' => (int) $matches[5] + (int) $matches[3],
                'status' => aggregateStatus((int) $matches[1], (int) $matches[2], (int) $matches[3]),
                'passRate' => round((float) $matches[4], 1),
            ];
            $results[] = $result;

            fwrite(
                STDERR,
                sprintf(
                    "    %s %d / %d (%.1f%%)\n",
                    str_pad($result['name'], 38),
                    $result['pass'],
                    $result['attempted'],
                    $result['passRate'],
                ),
            );
        }
    }

    usort($results, static fn(array $left, array $right): int => $left['name'] <=> $right['name']);

    $totalPass = array_sum(array_column($results, 'pass'));
    $totalFail = array_sum(array_column($results, 'fail'));
    $totalSkip = array_sum(array_column($results, 'skip'));
    $totalAttempted = array_sum(array_column($results, 'attempted'));

    return [
        'sampleLimit' => $limit,
        'jobs' => $jobs,
        'trackedCategories' => count($categories),
        'skippedFeatures' => array_values($skippedFeatures),
        'totals' => [
            'pass' => $totalPass,
            'fail' => $totalFail,
            'skip' => $totalSkip,
            'attempted' => $totalAttempted,
            'total' => $totalAttempted + $totalSkip,
            'passRate' => rateFromCounts($totalPass, $totalFail),
        ],
        'categories' => $results,
    ];
}

function countByStatus(array $tests, string $status): int
{
    $count = 0;
    foreach ($tests as $test) {
        if (($test['status'] ?? null) === $status) {
            $count++;
        }
    }

    return $count;
}

function rateFromCounts(int $pass, int $fail): float
{
    $attempted = $pass + $fail;
    if ($attempted === 0) {
        return 0.0;
    }

    return round(($pass / $attempted) * 100, 1);
}

function aggregateStatus(int $pass, int $fail, int $skip): string
{
    $attempted = $pass + $fail;
    if ($attempted === 0) {
        return $skip > 0 ? 'skipped' : 'empty';
    }
    if ($fail === 0) {
        return 'pass';
    }
    if ($pass === 0) {
        return 'fail';
    }

    return 'partial';
}

function formatRate(int $attempted, float $passRate): string
{
    if ($attempted === 0) {
        return 'n/a';
    }

    return sprintf('%.1f%%', $passRate);
}

/**
 * @return array{exitCode: int, output: string}
 */
function runShellCommand(string $command, string $rootDir): array
{
    $spec = [
        0 => ['pipe', 'r'],
        1 => ['pipe', 'w'],
        2 => ['pipe', 'w'],
    ];
    $process = proc_open($command, $spec, $pipes, $rootDir);
    if (!is_resource($process)) {
        return ['exitCode' => 1, 'output' => ''];
    }

    fclose($pipes[0]);
    $stdout = stream_get_contents($pipes[1]);
    fclose($pipes[1]);
    $stderr = stream_get_contents($pipes[2]);
    fclose($pipes[2]);
    $exitCode = proc_close($process);

    return [
        'exitCode' => $exitCode,
        'output' => $stdout . $stderr,
    ];
}

function relativePath(string $path, string $prefix): string
{
    $relative = str_starts_with($path, $prefix) ? substr($path, strlen($prefix)) : $path;

    return str_replace(DIRECTORY_SEPARATOR, '/', $relative);
}

function renderSupportMarkdown(array $snapshot): string
{
    $lines = [];
    $lines[] = '# Support Snapshot';
    $lines[] = '';
    $lines[] = 'Generated from automated tests. Do not edit by hand.';
    $lines[] = '';
    $lines[] = '- Refresh: `./bin/support-report`';
    $lines[] = '- Source of truth: scenario oracle regression plus sampled `test262` runs.';
    $lines[] = '- Snapshot time: `' . $snapshot['generatedAt'] . '`';
    if (($snapshot['git']['commit'] ?? null) !== null) {
        $lines[] = '- Git: `' . $snapshot['git']['branch'] . '` @ `' . $snapshot['git']['commit'] . '`'
            . (($snapshot['git']['isDirty'] ?? false) ? ' (dirty)' : '');
    }
    $lines[] = '';
    $lines[] = '## Summary';
    $lines[] = '';
    $lines[] = '| Area | Pass | Fail | Skip | Attempted | Rate |';
    $lines[] = '|---|---:|---:|---:|---:|---:|';
    $lines[] = sprintf(
        '| Scenarios | %d | %d | %d | %d | %.1f%% |',
        $snapshot['scenarios']['totals']['pass'],
        $snapshot['scenarios']['totals']['fail'],
        $snapshot['scenarios']['totals']['skip'],
        $snapshot['scenarios']['totals']['attempted'],
        $snapshot['scenarios']['totals']['passRate'],
    );
    $lines[] = sprintf(
        '| test262 sample (%d/category) | %d | %d | %d | %d | %.1f%% |',
        $snapshot['test262']['sampleLimit'],
        $snapshot['test262']['totals']['pass'],
        $snapshot['test262']['totals']['fail'],
        $snapshot['test262']['totals']['skip'],
        $snapshot['test262']['totals']['attempted'],
        $snapshot['test262']['totals']['passRate'],
    );
    $lines[] = '';
    $lines[] = '## Scenario Coverage';
    $lines[] = '';
    $lines[] = '| Category | Status | Pass | Fail | Skip | Rate |';
    $lines[] = '|---|---|---:|---:|---:|---:|';
    foreach ($snapshot['scenarios']['categories'] as $category) {
        $lines[] = sprintf(
            '| %s | %s | %d | %d | %d | %s |',
            $category['name'],
            strtoupper($category['status']),
            $category['pass'],
            $category['fail'],
            $category['skip'],
            formatRate($category['attempted'], $category['passRate']),
        );
    }
    $lines[] = '';
    $lines[] = '## Scenario Detail';
    $lines[] = '';
    $lines[] = '| Scenario | Mode | Status |';
    $lines[] = '|---|---|---|';
    foreach ($snapshot['scenarios']['tests'] as $test) {
        $status = strtoupper($test['status']);
        if ($test['message'] !== '') {
            $status .= ' - ' . $test['message'];
        }
        $lines[] = sprintf('| %s | %s | %s |', $test['name'], $test['mode'], $status);
    }
    $lines[] = '';
    $lines[] = '## test262 Coverage';
    $lines[] = '';
    $lines[] = '| Category | Status | Pass | Fail | Skip | Attempted | Rate | Visual |';
    $lines[] = '|---|---|---:|---:|---:|---:|---:|---|';
    foreach ($snapshot['test262']['categories'] as $category) {
        $lines[] = sprintf(
            '| %s | %s | %d | %d | %d | %d | %s | `%s` |',
            $category['name'],
            strtoupper($category['status']),
            $category['pass'],
            $category['fail'],
            $category['skip'],
            $category['attempted'],
            formatRate($category['attempted'], $category['passRate']),
            $category['attempted'] > 0 ? asciiBar($category['passRate']) : 'n/a',
        );
    }
    $lines[] = '';
    $lines[] = '## Explicitly Skipped test262 Feature Families';
    $lines[] = '';
    foreach ($snapshot['test262']['skippedFeatures'] as $feature) {
        $lines[] = '- `' . $feature . '`';
    }
    $lines[] = '';

    return implode("\n", $lines);
}

function asciiBar(float $rate, int $width = 20): string
{
    $filled = (int) round(($rate / 100) * $width);
    $filled = max(0, min($width, $filled));

    return str_repeat('#', $filled) . str_repeat('-', $width - $filled);
}
