<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnRisky="true"
         failOnWarning="true">
    <php>
        <!-- WPT fixtures (crypto / pbkdf2 / hkdf with thousands of
             permutations, and the larger response/fetch fixtures)
             need more headroom than PHP's default 128M. Match what
             bin/wpt sets so phpunit and the CLI runner agree. -->
        <ini name="memory_limit" value="2G"/>
    </php>
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="oracle">
            <directory>tests/Oracle</directory>
        </testsuite>
        <testsuite name="popular">
            <directory>tests/Popular</directory>
        </testsuite>
        <testsuite name="wpt">
            <directory>tests/Wpt</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
