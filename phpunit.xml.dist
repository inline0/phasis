<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/13.0/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnRisky="true"
         failOnWarning="true">
    <php>
        <!-- WPT fixtures (crypto / pbkdf2 / hkdf with thousands of
             permutations, console-log-large-array, and the larger
             response/fetch fixtures) need more headroom than PHP's
             default 128M; the large-array console fixture alone peaks
             near 1.8G, so a full-suite run with ~900 tests of
             accumulated state needs 4G. Match what bin/wpt sets so
             phpunit and the CLI runner agree. -->
        <ini name="memory_limit" value="4G"/>
        <!-- Pin UTC so Date-touching tests (popular-package oracles
             that exercise dayjs/date-fns, WPT fixtures that touch the
             Date constructor) produce byte-identical output on every
             machine. Without this the dev box (CET/CEST) and CI
             (UTC) diverge on any local-TZ format. -->
        <ini name="date.timezone" value="UTC"/>
    </php>
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="oracle">
            <directory>tests/Oracle</directory>
        </testsuite>
        <testsuite name="popular">
            <directory>tests/Popular</directory>
        </testsuite>
        <testsuite name="wpt">
            <directory>tests/Wpt</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
