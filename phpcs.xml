<?xml version="1.0"?>
<ruleset name="phasis">
    <description>Coding standards for phasis</description>

    <file>src</file>
    <file>tests</file>

    <exclude-pattern>src/Regex/UnicodeTables.php</exclude-pattern>
    <exclude-pattern>src/Regex/FoldTable.php</exclude-pattern>
    <exclude-pattern>src/BuiltIn/data/*</exclude-pattern>
    <!-- React's inline runtime scripts, generated byte for byte from react-dom. -->
    <exclude-pattern>src/BuiltIn/Jsx/React/Fizz/Scripts.php</exclude-pattern>
    <exclude-pattern>tests/Popular/*</exclude-pattern>
    <!-- Framework toolchains and unchanged upstream sources are third-party fixtures. -->
    <exclude-pattern>tests/Frameworks/node_modules/*</exclude-pattern>
    <exclude-pattern>tests/Frameworks/*/upstream/*</exclude-pattern>
    <exclude-pattern>tests/Frameworks/*/.generated/*</exclude-pattern>
    <exclude-pattern>tests/Frameworks/*/results/*</exclude-pattern>
    <!-- JSX fixtures and the Node oracle toolchain; the PHP tests sit directly in tests/Jsx. -->
    <exclude-pattern>tests/Jsx/*/*</exclude-pattern>
    <exclude-pattern>tests/Unit/Formatter/fixtures/*</exclude-pattern>
    <exclude-pattern>tests/Unit/BuiltIn/fixtures/*</exclude-pattern>
    <exclude-pattern>tests/Unit/Bytecode/fixtures/*</exclude-pattern>
    <exclude-pattern>tests/Unit/Runtime/fixtures/*</exclude-pattern>
    <exclude-pattern>tests/Wpt/fixtures/*</exclude-pattern>
    <exclude-pattern>tests/Wpt/testharness-shim.js</exclude-pattern>
    <exclude-pattern>tests/Wpt/upstream/*</exclude-pattern>
    <exclude-pattern>tests/Wpt/fetch-server.php</exclude-pattern>

    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="PSR12"/>

    <!--
        Soft and absolute line limits both set to 150.
        The 120-char soft limit was aspirational and never enforced
        (verify-all runs phpcs with -warning-severity=0). Aligning
        the soft limit with the absolute limit keeps phpcs clean for
        real violations (anything beyond 150 still hard-errors).
    -->
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="150"/>
            <property name="absoluteLineLimit" value="150"/>
        </properties>
    </rule>
</ruleset>
